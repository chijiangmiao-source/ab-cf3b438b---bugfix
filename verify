def http_request(base: str, method: str, path: str, body=None):
    data = None
    headers = {}
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(base.rstrip("/") + path, data=data, headers=headers,
                                 method=method)
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return resp.status, json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        return exc.code, json.loads(exc.read().decode())


def http_mode(base: str):
    print(f"== HTTP 验收 @ {base} ==")
    status, body = http_request(base, "GET", "/health")
    check("GET /health 200", status == 200 and body.get("status") == "ok", str(body))

    status, body = http_request(base, "POST", "/verify",
                                {"alphabet": ["0", "1"], "codewords": ["0", "01", "10"]})
    check("歧义用例 200", status == 200 and body.get("unique") is False, str(body)[:200])
    if status == 200 and body.get("ambiguity"):
        amb = body["ambiguity"]
        check("HTTP joined_a == joined_b == 010",
              amb["joined_a"] == amb["joined_b"] == "010",
              f"{amb['joined_a']} vs {amb['joined_b']}")
        check("HTTP 序列不同", amb["sequences_differ"] is True)
        check("HTTP 含逐步推导", len(amb["derivation"]) >= 2)

    status, body = http_request(base, "POST", "/verify",
                                {"alphabet": ["0", "1"], "codewords": ["00", "01", "10", "11"]})
    check("唯一用例 200", status == 200 and body.get("unique") is True)
    check("唯一用例残串轮存在", isinstance(body.get("rounds"), list) and body["rounds"])

    # 报告用例（HTTP 冒烟）：字母表 ["b","a"] 与 ASCII 序相反，等长候选
    # 须按完整编码串的字母表序裁决出 bbbab，全部字段互相一致。
    reported = {"alphabet": ["b", "a"], "codewords": ["bbba", "b", "abba", "ab"]}
    status, body = http_request(base, "POST", "/verify", reported)
    check("报告用例 HTTP 200", status == 200, str(status)[:100])
    if status == 200:
        check("报告用例 unique=false", body.get("unique") is False)
        amb = body.get("ambiguity") or {}
        check("报告用例 encoded_string=bbbab 且长度5",
              amb.get("encoded_string") == "bbbab" and amb.get("length") == 5,
              str(amb.get("encoded_string")))
        check("报告用例 规范索引 [0,1] / [1,1,1,3]",
              amb.get("indices_a") == [0, 1] and amb.get("indices_b") == [1, 1, 1, 3],
              f"{amb.get('indices_a')} / {amb.get('indices_b')}")
        words = reported["codewords"]
        ja = "".join(words[i] for i in amb.get("indices_a", []))
        jb = "".join(words[i] for i in amb.get("indices_b", []))
        check("报告用例 两组索引各自从原码字拼出 bbbab",
              ja == jb == "bbbab" == amb.get("joined_a") == amb.get("joined_b"),
              f"{ja} / {jb}")
        check("报告用例 拼接明细一致",
              amb.get("concatenation_a") == ["bbba", "b"]
              and amb.get("concatenation_b") == ["b", "b", "b", "ab"],
              str(amb.get("concatenation_b")))
        steps = amb.get("derivation") or []
        check("报告用例 推导到达空残串",
              bool(steps) and steps[-1].get("epsilon_after") is True
              and steps[-1].get("residual_after") == "")
        err = replay_witness(words, "bbbab", [0, 1], [1, 1, 1, 3], steps)
        check("报告用例 逐步推导机械复核", err is None, err or "")

    # 同一组码字、字母表改为 ASCII 序 ["a","b"]：裁决须翻转回 abbab。
    status, body = http_request(base, "POST", "/verify",
                                {"alphabet": ["a", "b"],
                                 "codewords": ["bbba", "b", "abba", "ab"]})
    check("ASCII序变体 200 且歧义", status == 200 and body.get("unique") is False)
    if status == 200 and body.get("ambiguity"):
        amb = body["ambiguity"]
        check("ASCII序变体 选 abbab",
              amb.get("encoded_string") == "abbab"
              and amb.get("indices_a") == [2, 1]
              and amb.get("indices_b") == [3, 1, 3],
              str(amb.get("encoded_string")))

    # 更短歧义串恒优先：追加 "a" 后长度 2 的 "ab" 击败长度 5 的候选。
    status, body = http_request(base, "POST", "/verify",
                                {"alphabet": ["b", "a"],
                                 "codewords": ["bbba", "b", "abba", "ab", "a"]})
    check("更短串优先 200 且歧义", status == 200 and body.get("unique") is False)
    if status == 200 and body.get("ambiguity"):
        amb = body["ambiguity"]
        check("更短串 ab 优先",
              amb.get("encoded_string") == "ab" and amb.get("length") == 2
              and amb.get("indices_a") == [3] and amb.get("indices_b") == [4, 1],
              str(amb.get("encoded_string")))

    status, body = http_request(base, "POST", "/verify",
                                {"alphabet": ["0", "1"], "codewords": [""]})
    check("非法输入 422", status == 422 and body.get("error", {}).get("issues"))
    if status == 422:
        loc = body["error"]["issues"][0]["loc"]
        check("422 含位置", loc and loc[0] == "body", str(loc))


def main():
    parser = argparse.ArgumentParser(description="验收服务")
    parser.add_argument("--url", help="运行中服务的 base URL，缺省为进程内直跑")
    parser.add_argument("--fuzz", type=int, default=400, help="随机对拍数量")
    args = parser.parse_args()

    if args.url:
        http_mode(args.url)
    else:
        fixed_cases()
        invalid_cases()
        fuzz(args.fuzz)

    print(f"\n共 {checks} 项检查，失败 {len(failures)} 项")
    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
