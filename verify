INVALID_CASES = [
    ("码字为空串", {"alphabet": ["0", "1"], "codewords": ["0", ""]}, "empty_codeword"),
    ("码字重复", {"alphabet": ["0", "1"], "codewords": ["0", "0"]}, "duplicate_codeword"),
    ("码字数仅1", {"alphabet": ["0", "1"], "codewords": ["0"]}, "invalid_size"),
    ("码字数401", {"alphabet": ["0", "1"], "codewords": ["0"] * 401}, "invalid_size"),
    ("字母表仅1", {"alphabet": ["0"], "codewords": ["0", "1"]}, "invalid_size"),
    ("字母表9", {"alphabet": list("012345678"), "codewords": ["0", "1"]}, "invalid_size"),
    ("字母表重复", {"alphabet": ["0", "0"], "codewords": ["0", "1"]}, "duplicate_symbol"),
    ("非ASCII符号", {"alphabet": ["0", "é"], "codewords": ["0", "1"]}, "not_ascii"),
    ("越界字符定位", {"alphabet": ["0", "1"], "codewords": ["0", "1x"]}, "symbol_not_in_alphabet"),
    ("超长码字257", {"alphabet": ["0"], "codewords_will_build": True}, "codeword_too_long"),
    ("总长超20000", {"alphabet": ["0"], "total": True}, "total_length_exceeded"),
    ("缺字段", {"alphabet": ["0", "1"]}, "missing_field"),
    ("类型错误", {"alphabet": ["0", "1"], "codewords": [0, "1"]}, "not_a_string"),
]


def build_special(name: str):
    if name == "超长码字257":
        return {"alphabet": ["0", "1"], "codewords": ["0", "1" * 257]}
    if name == "总长超20000":
        # 79 个互异的 256 长码字（零填充二进制）+ 一个 "0"：
        # 总长 79*256+1 = 20225 > 20000，且各码字互异。
        big = [bin(i)[2:].zfill(256) for i in range(79)]
        return {"alphabet": ["0", "1"], "codewords": big + ["0"]}
    return None


def invalid_cases():
    print("== 非法输入（结构化 422，含位置）==")
    for name, payload, expected_code in INVALID_CASES:
        special = build_special(name)
        data = special if special is not None else payload
        valid, issues = validate_payload(data)
        codes = [i.code for i in issues]
        locs = [tuple(i.loc) for i in issues]
        check(f"非法[{name}] 被拒", valid is None and expected_code in codes,
              f"codes={codes}")
        check(f"非法[{name}] 带位置", any(len(loc) >= 2 for loc in locs), f"locs={locs}")
        if name == "越界字符定位":
            issue = next(i for i in issues if i.code == "symbol_not_in_alphabet")
            check("越界字符位置 codewords[1].char[1]",
                  tuple(issue.loc) == ("body", "codewords", 1, "char", 1),
                  repr(issue.loc))


