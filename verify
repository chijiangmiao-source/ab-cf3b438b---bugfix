INVALID_CASES = [
    ("码字为空串", {"alphabet": ["0", "1"], "codewords": ["0", ""]}, "empty_codeword"),
    ("码字重复", {"alphabet": ["0", "1"], "codewords": ["0", "0"]}, "duplicate_codeword"),
    ("码字数仅1", {"alphabet": ["0", "1"], "codewords": ["0"]}, "invalid_size"),
    ("码字数401", {"alphabet": ["0", "1"], "codewords": ["0"] * 401}, "invalid_size"),
    ("字母表仅1", {"alphabet": ["0"], "codewords": ["0", "1"]}, "invalid_size"),
    ("字母表9", {"alphabet": list("012345678"), "codewords": ["0", "1"]}, "invalid_size"),
    ("字母表重复", {"alphabet": ["0", "0"], "codewords": ["0", "1"]}, "duplicate_symbol"),
    ("非ASCII符号", {"alphabet": ["0", "é"], "codewords": ["0", "1"]}, "not_ascii"),
    ("越界字符定位", {"alphabet": ["0", "1"], "codewords": ["0", "1x"]}, "symbol_not_in_alphabet"),
    ("超长码字257", {"alphabet": ["0"], "codewords_will_build": True}, "codeword_too_long"),
    ("总长超20000", {"alphabet": ["0"], "total": True}, "total_length_exceeded"),
    ("缺字段", {"alphabet": ["0", "1"]}, "missing_field"),
    ("类型错误", {"alphabet": ["0", "1"], "codewords": [0, "1"]}, "not_a_string"),
]


def build_special(name: str):
    if name == "超长码字257":
        return {"alphabet": ["0", "1"], "codewords": ["0", "1" * 257]}
    if name == "总长超20000":
        # 79 个互异的 256 长码字（零填充二进制）+ 一个 "0"：
        # 总长 79*256+1 = 20225 > 20000，且各码字互异。
        big = [bin(i)[2:].zfill(256) for i in range(79)]
        return {"alphabet": ["0", "1"], "codewords": big + ["0"]}
    return None


def invalid_cases():
    print("== 非法输入（结构化 422，含位置）==")
    for name, payload, expected_code in INVALID_CASES:
        special = build_special(name)
        data = special if special is not None else payload
        valid, issues = validate_payload(data)
        codes = [i.code for i in issues]
        locs = [tuple(i.loc) for i in issues]
        check(f"非法[{name}] 被拒", valid is None and expected_code in codes,
              f"codes={codes}")
        check(f"非法[{name}] 带位置", any(len(loc) >= 2 for loc in locs), f"locs={locs}")
        if name == "越界字符定位":
            issue = next(i for i in issues if i.code == "symbol_not_in_alphabet")
            check("越界字符位置 codewords[1].char[1]",
                  tuple(issue.loc) == ("body", "codewords", 1, "char", 1),
                  repr(issue.loc))


# ---------------------------------------------------------------------------
# 随机模糊对拍
# ---------------------------------------------------------------------------


def fuzz_case(rng: random.Random) -> bool:
    m = rng.randint(2, 4)
    alpha = list(string.digits[:m])
    n = rng.randint(2, 6)
    words: list[str] = []
    while len(words) < n:
        L = rng.randint(1, 3)
        w = "".join(rng.choice(alpha) for _ in range(L))
        if w and w not in words:
            words.append(w)

    ok_engine, engine_payload = run_engine(alpha, words)
    depth = {2: 11, 3: 9, 4: 8}.get(n, 7)
    amb_brute, best_brute, brute_seqs = brute_force(words, alpha, max_depth=depth)

    if not ok_engine:
        # 引擎声称歧义：连接等式必须成立，序列必须不同。
        (key, (a, b)) = engine_payload
        codec = Codec(alpha)
        sa = b"".join(codec.encode(words[i]) for i in a)
        sb = b"".join(codec.encode(words[i]) for i in b)
        if sa != sb or a == b:
            print(f"\n模糊失败(见证不成立): {alpha} {words} {a} {b}")
            return False
        if amb_brute and key != best_brute:
            print(f"\n模糊失败(裁决不一致): {words}\n engine={key}\n brute ={best_brute}")
            return False
    else:
        # 引擎声称唯一：暴力在深度7内不得发现碰撞（若发现则结论错误）。
        if amb_brute:
            print(f"\n模糊失败(漏报歧义): {words} brute={best_brute}")
            return False
    return True


def fuzz(count: int):
    print(f"== 随机对拍 x{count} ==")
    rng = random.Random(20260919)
    failed = 0
    for i in range(count):
        if not fuzz_case(rng):
            failed += 1
            if failed >= 5:
                break
    check(f"随机对拍全部通过", failed == 0, f"{failed} 个失败")


# ---------------------------------------------------------------------------
# HTTP 模式
# ---------------------------------------------------------------------------


def http_request(base: str, method: str, path: str, body=None):
    data = None
    headers = {}
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(base.rstrip("/") + path, data=data, headers=headers,
                                 method=method)
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return resp.status, json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        return exc.code, json.loads(exc.read().decode())


def http_mode(base: str):
    print(f"== HTTP 验收 @ {base} ==")
    status, body = http_request(base, "GET", "/health")
    check("GET /health 200", status == 200 and body.get("status") == "ok", str(body))

    status, body = http_request(base, "POST", "/verify",
                                {"alphabet": ["0", "1"], "codewords": ["0", "01", "10"]})
    check("歧义用例 200", status == 200 and body.get("unique") is False, str(body)[:200])
    if status == 200 and body.get("ambiguity"):
        amb = body["ambiguity"]
        check("HTTP joined_a == joined_b == 010",
              amb["joined_a"] == amb["joined_b"] == "010",
              f"{amb['joined_a']} vs {amb['joined_b']}")
        check("HTTP 序列不同", amb["sequences_differ"] is True)
        check("HTTP 含逐步推导", len(amb["derivation"]) >= 2)

    status, body = http_request(base, "POST", "/verify",
                                {"alphabet": ["b", "a"],
                                 "codewords": ["bbba", "b", "abba", "ab"]})
    check("HTTP 标题用例 200 且 unique=false",
          status == 200 and body.get("unique") is False, str(body)[:200])
    if status == 200 and body.get("ambiguity"):
        amb = body["ambiguity"]
        words = ["bbba", "b", "abba", "ab"]
        join = lambda seq: "".join(words[i] for i in seq)
        check("HTTP 等长裁决串为 bbbab/长度5",
              amb["encoded_string"] == "bbbab" and amb["length"] == 5,
              amb.get("encoded_string"))
        check("HTTP 规范索引 [0,1] 与 [1,1,1,3]",
              amb["indices_a"] == [0, 1] and amb["indices_b"] == [1, 1, 1, 3],
              f'{amb.get("indices_a")} {amb.get("indices_b")}')
        check("HTTP 两组索引重新拼出 bbbab",
              join(amb["indices_a"]) == join(amb["indices_b"]) == "bbbab"
              == amb["encoded_string"],
              f'{amb.get("joined_a")} {amb.get("joined_b")}')
        check("HTTP 推导到达空残串",
              amb["derivation"][-1]["residual_after"] == ""
              and amb["derivation"][-1]["epsilon_after"] is True)

    status, body = http_request(base, "POST", "/verify",
                                {"alphabet": ["0", "1"], "codewords": ["00", "01", "10", "11"]})
    check("唯一用例 200", status == 200 and body.get("unique") is True)
    check("唯一用例残串轮存在", isinstance(body.get("rounds"), list) and body["rounds"])

    status, body = http_request(base, "POST", "/verify",
                                {"alphabet": ["0", "1"], "codewords": [""]})
    check("非法输入 422", status == 422 and body.get("error", {}).get("issues"))
    if status == 422:
        loc = body["error"]["issues"][0]["loc"]
        check("422 含位置", loc and loc[0] == "body", str(loc))


def main():
    parser = argparse.ArgumentParser(description="验收服务")
    parser.add_argument("--url", help="运行中服务的 base URL，缺省为进程内直跑")
    parser.add_argument("--fuzz", type=int, default=400, help="随机对拍数量")
    args = parser.parse_args()

    if args.url:
        http_mode(args.url)
    else:
        fixed_cases()
        invalid_cases()
        fuzz(args.fuzz)

    print(f"\n共 {checks} 项检查，失败 {len(failures)} 项")
    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
