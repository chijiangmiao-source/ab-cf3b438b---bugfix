# 随机模糊对拍
# ---------------------------------------------------------------------------


def fuzz_case(rng: random.Random) -> bool:
    m = rng.randint(2, 4)
    alpha = list(string.digits[:m])
    # 随机打乱字母表顺序：字母表序通常不同于 ASCII 序，等长候选的
    # 字母表序裁决（含多条等长路径汇入同一残串状态的情形）随之被
    # 持续对拍覆盖。
    rng.shuffle(alpha)
    n = rng.randint(2, 6)
    words: list[str] = []
    while len(words) < n:
        L = rng.randint(1, 3)
        w = "".join(rng.choice(alpha) for _ in range(L))
        if w and w not in words:
            words.append(w)

    ok_engine, engine_payload = run_engine(alpha, words)
    depth = {2: 11, 3: 9, 4: 8}.get(n, 7)
    amb_brute, best_brute, brute_seqs = brute_force(words, alpha, max_depth=depth)

    if not ok_engine:
        # 引擎声称歧义：连接等式必须成立，序列必须不同。
        (key, (a, b)) = engine_payload
        codec = Codec(alpha)
        sa = b"".join(codec.encode(words[i]) for i in a)
        sb = b"".join(codec.encode(words[i]) for i in b)
        if sa != sb or a == b:
            print(f"\n模糊失败(见证不成立): {alpha} {words} {a} {b}")
            return False
        if amb_brute and key != best_brute:
            print(f"\n模糊失败(裁决不一致): {words}\n engine={key}\n brute ={best_brute}")
            return False
    else:
        # 引擎声称唯一：暴力在深度7内不得发现碰撞（若发现则结论错误）。
        if amb_brute:
            print(f"\n模糊失败(漏报歧义): {words} brute={best_brute}")
            return False
    return True


def fuzz(count: int):
    print(f"== 随机对拍 x{count} ==")
    rng = random.Random(20260919)
    failed = 0
    for i in range(count):
        if not fuzz_case(rng):
            failed += 1
            if failed >= 5:
                break
    check(f"随机对拍全部通过", failed == 0, f"{failed} 个失败")


